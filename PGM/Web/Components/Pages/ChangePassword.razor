@page "/account/change-password"
@inject AuthTokenStore TokenStore
@inject PgmApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>重設密碼 - PGM</PageTitle>

<div class="reset-page">
    <h1 class="reset-title">重設密碼</h1>

    <button type="button" class="reset-save" disabled="@_saving" @onclick="SaveAsync">
        @(_saving ? "儲存中…" : "儲存")
    </button>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="reset-message @(_isError ? "is-error" : "is-ok")" role="alert">@_message</div>
    }

    <table class="reset-table">
        <tbody>
            <tr>
                <th scope="row">帳號</th>
                <td class="readonly-cell">@_userId</td>
            </tr>
            <tr>
                <th scope="row">新密碼</th>
                <td>
                    <input class="reset-input" type="password" autocomplete="new-password"
                           @bind="_newPassword" @bind:event="oninput" />
                </td>
            </tr>
            <tr>
                <th scope="row">確認密碼</th>
                <td>
                    <input class="reset-input" type="password" autocomplete="new-password"
                           @bind="_confirmPassword" @bind:event="oninput" />
                </td>
            </tr>
        </tbody>
    </table>
    <p class="form-text mt-3 mb-0">首次以預設密碼登入後必須變更；新密碼不可為預設碼，且至少 8 字元。</p>
</div>

@code {
    private string _userId = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _message;
    private bool _isError;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        var session = await TokenStore.GetAsync();
        if (session is null || session.IsExpired)
        {
            Navigation.NavigateTo("/login", replace: true);
            return;
        }

        _userId = session.User.UserId;
    }

    private async Task SaveAsync()
    {
        _message = null;
        _isError = false;

        if (string.IsNullOrWhiteSpace(_newPassword) || string.IsNullOrWhiteSpace(_confirmPassword))
        {
            _isError = true;
            _message = "請輸入新密碼與確認密碼。";
            return;
        }

        if (!string.Equals(_newPassword, _confirmPassword, StringComparison.Ordinal))
        {
            _isError = true;
            _message = "新密碼與確認密碼不一致。";
            return;
        }

        _saving = true;
        try
        {
            var result = await ApiClient.ChangePasswordAsync(new ChangePasswordRequest
            {
                NewPassword = _newPassword,
                ConfirmPassword = _confirmPassword
            });

            if (!result.Succeeded)
            {
                _isError = true;
                _message = string.IsNullOrWhiteSpace(result.ErrorMessage)
                    ? "重設密碼失敗，請稍後再試。"
                    : result.ErrorMessage;
                if (result.IsUnauthorized)
                    Navigation.NavigateTo("/login", replace: true);
                return;
            }

            _isError = false;
            _message = "密碼已更新，請使用新密碼繼續使用系統。";
            Navigation.NavigateTo("/", replace: true);
        }
        finally
        {
            _saving = false;
        }
    }
}
