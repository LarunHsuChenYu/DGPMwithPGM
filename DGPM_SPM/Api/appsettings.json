{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EnableSwagger": false,
  "env": {
    "name": "sit"
  },
  "JwtSettings": {
    "Issuer": "PGM.Api",
    "Audience": "PGM.Api",
    "ExpirationHours": 24,
    "AccessTokenMinutes": 240
  },
  "Auth": {
    "AllowPGMLoginEntry": true,
    "PgmBaseUrl": "http://localhost:5170",
    "PgmWebBaseUrl": "https://localhost:7230",
    "SystemCode": "DGPM"
  }
}
