<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!--
        IIS 預設 WebDAV 常攔截 PUT／DELETE，導致 Debug（Kestrel）可寫、正式 IIS 新增（POST）正常但編輯（PUT）失敗。
        部署 Api 站台時必須移除 WebDAV，並確保 aspNetCore handler 接受全部 verb。
      -->
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!--
        正式部署環境變數以本檔為準（會隨 publish 一併輸出）。
        User Secrets 僅 Development 生效；缺 Jwt／連線字串時 Api 會拒絕啟動（見 stdout / Event Log）。
        作品集版已改為占位符，請替換成自己的設定。
      -->
      <aspNetCore processPath="dotnet" arguments=".\DGPM_SPM.Api.dll"
                  stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <environmentVariable name="JwtSettings__SecretKey" value="REPLACE_WITH_YOUR_JWT_SECRET_AT_LEAST_32_CHARS" />
          <environmentVariable name="ConnectionStrings__DefaultConnection" value="Server=YOUR_SQL_SERVER;Database=DGPM_SPM_DEV;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;Encrypt=True;" />
          <environmentVariable name="Auth__PgmBaseUrl" value="http://localhost:9528" />
          <environmentVariable name="Auth__PgmWebBaseUrl" value="http://localhost:8965" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
